# Option A: GitHub App Authentication (Recommended - Zero user tokens)
# Create a GitHub App at https://github.com/settings/apps with 'Actions: Read-only' permission
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
# Or paste key content directly: GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n..."
GITHUB_APP_INSTALLATION_ID=

# Option B: GitHub Personal Access Token (PAT) with 'repo' scope (Optional fallback)
GITHUB_TOKEN=your_personal_access_token_here
BACKEND_PORT=8001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional Webhook Secret configured in GitHub repository webhook settings
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# AI / LLM Configuration (OpenAI or Groq)
# Optional: If unset, system runs high-accuracy autonomous heuristic reasoning
OPENAI_API_KEY=
GROQ_API_KEY=
LLM_MODEL=gpt-4o-mini

# Database Configuration (Defaults to embedded SQLite incidents_kb.db; supports PostgreSQL connection string)
DATABASE_URL=sqlite:///incidents_kb.db
